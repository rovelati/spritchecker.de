---
import Layout from '@layouts/Layout.astro';
import cities from '@data/german_cities.json';

const title = "Super E10 Preise aktuell — Günstigste E10-Tankstelle in der Nähe | SpritChecker.de";
const description = "Aktuelle Super E10 Preise vergleichen und günstig Benzin tanken. Finde die billigste Tankstelle für Super E10 heute in deiner Region.";
---

<Layout title={title} description={description} canonical="https://spritchecker.de/spritpreise/super-e10/">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="bg-gradient-to-br from-zinc-900 to-zinc-950 border border-zinc-800 rounded-3xl p-8 sm:p-12 shadow-2xl mb-12">
      <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider font-mono">SUPER E10 PREISVERGLEICH</span>
      <h1 class="text-3xl sm:text-5xl font-black text-white mt-2 mb-4">
        Super E10 Preise aktuell: <span class="text-emerald-400">Günstig E10 tanken</span>
      </h1>
      <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl">
        Super E10 ist in Deutschland meist 5 bis 6 Cent pro Liter günstiger als Super E5. Vergleiche die tagesaktuellen Preise an allen Tankstellen.
      </p>
    </div>

    <!-- Quick City Selector for E10 -->
    <h2 class="text-2xl font-bold text-white mb-6">Super E10 Preise nach Stadt</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {cities.map(c => (
        <a
          href={`/tankstellen/stadt-${c.slug}/super-e10/`}
          class="p-3.5 bg-zinc-900 border border-zinc-800 hover:border-emerald-500/50 rounded-xl transition-all block group"
        >
          <div class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">{c.name}</div>
          <div class="text-xs text-zinc-500">Super E10 vergleichen</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
