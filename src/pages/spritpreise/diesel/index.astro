---
import Layout from '@layouts/Layout.astro';
import cities from '@data/german_cities.json';

const title = "Dieselpreise aktuell — Günstigste Diesel-Tankstelle in der Nähe | SpritChecker.de";
const description = "Aktuelle Dieselpreise in Deutschland vergleichen. Finde die billigste Tankstelle für Diesel heute in deiner Stadt mit Echtzeitdaten des Bundeskartellamtes.";
---

<Layout title={title} description={description} canonical="https://spritchecker.de/spritpreise/diesel/">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="bg-gradient-to-br from-zinc-900 to-zinc-950 border border-zinc-800 rounded-3xl p-8 sm:p-12 shadow-2xl mb-12">
      <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider font-mono">DIESELPREISVERGLEICH DEUTSCHLAND</span>
      <h1 class="text-3xl sm:text-5xl font-black text-white mt-2 mb-4">
        Dieselpreise aktuell: <span class="text-emerald-400">Günstig Diesel tanken</span>
      </h1>
      <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl">
        Vergleiche die aktuellen Dieselpreise in deiner Umgebung. Die Daten stammen direkt von der offiziellen Markttransparenzstelle für Kraftstoffe (MTS-K).
      </p>
    </div>

    <!-- Quick City Selector for Diesel -->
    <h2 class="text-2xl font-bold text-white mb-6">Dieselpreise nach Stadt</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {cities.map(c => (
        <a
          href={`/tankstellen/stadt-${c.slug}/diesel/`}
          class="p-3.5 bg-zinc-900 border border-zinc-800 hover:border-emerald-500/50 rounded-xl transition-all block group"
        >
          <div class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">{c.name}</div>
          <div class="text-xs text-zinc-500">Diesel günstig tanken</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
