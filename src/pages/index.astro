---
import Layout from '../layouts/Layout.astro';
import cities from '@data/german_cities.json';
import bundeslaender from '@data/bundeslaender.json';

const title = "SpritChecker.de — Spritpreise aktuell & Günstig tanken in Deutschland";
const description = "Aktuelle Benzin- und Dieselpreise an über 15.000 Tankstellen in Deutschland vergleichen. Finde jetzt die günstigste Tankstelle für Super E10, Super E5 und Diesel in deiner Stadt.";

// Top 36 major German cities for homepage prominent grid
const topCities = cities.slice(0, 36);

// Group cities alphabetically for the full SEO crawlable directory
const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const citiesByLetter: Record<string, typeof cities> = {};
alphabet.forEach(letter => {
  citiesByLetter[letter] = cities.filter(c => c.name.toUpperCase().startsWith(letter)).slice(0, 30);
});
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 px-4 border-b border-zinc-800 bg-gradient-to-b from-zinc-900/80 to-zinc-950">
    <div class="max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Offizielle Echtzeit-Daten der Markttransparenzstelle (MTS-K / Bundeskartellamt)
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-white mb-4">
        Spritpreise aktuell: <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Günstig tanken</span> in ganz Deutschland
      </h1>

      <p class="text-base sm:text-lg text-zinc-300 max-w-2xl mx-auto mb-8">
        Vergleiche die aktuellen Preise für <strong>Super E10</strong>, <strong>Super E5</strong> und <strong>Diesel</strong> in über 3.000 Städten und Gemeinden.
      </p>

      <!-- Direct Navigation Search Form -->
      <div id="suche" class="max-w-xl mx-auto bg-zinc-900 border border-zinc-700/80 p-3 sm:p-4 rounded-2xl shadow-2xl shadow-black/80">
        <form id="search-form" class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-grow">
            <input
              type="text"
              id="search-input"
              list="cities-datalist"
              placeholder="Stadt eingeben (z.B. Berlin, München, Köln)..."
              class="w-full bg-zinc-950 border border-zinc-700 rounded-xl px-4 py-3.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition-colors"
              autocomplete="off"
              required
            />
            <datalist id="cities-datalist">
              {cities.slice(0, 500).map(c => (
                <option value={c.name} data-slug={c.slug}>{c.name}</option>
              ))}
            </datalist>
          </div>
          <button
            type="submit"
            class="px-6 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold rounded-xl text-sm transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-emerald-500/20"
          >
            <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            Preise anzeigen
          </button>
        </form>

        <div class="mt-3 flex items-center justify-between text-xs text-zinc-400 pt-2 border-t border-zinc-800">
          <button
            type="button"
            id="geolocate-btn"
            class="inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 font-semibold cursor-pointer transition-colors"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
            </svg>
            Standort ermitteln (GPS)
          </button>
          <span class="text-zinc-500 font-mono">3.000 Städte indexiert</span>
        </div>
      </div>
    </div>
  </section>

  <!-- High-Volume Pillar Pages Bar -->
  <section class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a
        href="/spritpreise/diesel/"
        class="p-5 bg-zinc-900 border border-zinc-800 hover:border-emerald-500/60 rounded-2xl transition-all group block shadow-lg"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider font-mono">KRAFTSTOFF</span>
          <span class="text-zinc-500 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all">→</span>
        </div>
        <h2 class="text-lg font-bold text-white mb-1">Dieselpreise aktuell</h2>
        <p class="text-xs text-zinc-400">Finde die billigste Tankstelle für Diesel in ganz Deutschland.</p>
      </a>

      <a
        href="/spritpreise/super-e10/"
        class="p-5 bg-zinc-900 border border-zinc-800 hover:border-emerald-500/60 rounded-2xl transition-all group block shadow-lg"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider font-mono">KRAFTSTOFF</span>
          <span class="text-zinc-500 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all">→</span>
        </div>
        <h2 class="text-lg font-bold text-white mb-1">Super E10 Preise</h2>
        <p class="text-xs text-zinc-400">Die günstigsten E10-Tankstellen im direkten Preisvergleich.</p>
      </a>

      <a
        href="/spritpreise/super-e5/"
        class="p-5 bg-zinc-900 border border-zinc-800 hover:border-emerald-500/60 rounded-2xl transition-all group block shadow-lg"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider font-mono">KRAFTSTOFF</span>
          <span class="text-zinc-500 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all">→</span>
        </div>
        <h2 class="text-lg font-bold text-white mb-1">Super E5 (Benzin)</h2>
        <p class="text-xs text-zinc-400">Vergleiche die Super 95 Preise tagesaktuell in deiner Nähe.</p>
      </a>

      <a
        href="/billig-tanken/"
        class="p-5 bg-zinc-900 border border-zinc-800 hover:border-emerald-500/60 rounded-2xl transition-all group block shadow-lg"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-wider font-mono">SPARTIPPS</span>
          <span class="text-zinc-500 group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all">→</span>
        </div>
        <h2 class="text-lg font-bold text-white mb-1">Billig tanken Ratgeber</h2>
        <p class="text-xs text-zinc-400">Die besten Uhrzeiten und Tricks: Bis zu 15 Cent/Liter sparen.</p>
      </a>
    </div>
  </section>

  <!-- Interactive Leaflet Radar Map -->
  <section class="max-w-6xl mx-auto px-4 py-6">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden shadow-xl">
      <div class="p-4 border-b border-zinc-800 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">Live-Radar: Tankstellen in Deutschland</h2>
          <p class="text-xs text-zinc-400">Klicke auf eine Station, um Preise zu sehen und zur Stadtseite zu navigieren</p>
        </div>
      </div>
      <div id="map" class="w-full h-[400px] bg-zinc-950"></div>
    </div>
  </section>

  <!-- Top Cities Section with Real Navigation Links & Fuel Sublinks -->
  <section id="staedte" class="max-w-6xl mx-auto px-4 py-12 border-t border-zinc-800">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-black text-white mb-3">Spritpreise in den größten Städten</h2>
      <p class="text-sm text-zinc-400">Klicke auf deine Stadt für die vollständige Liste der günstigsten Tankstellen.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {topCities.map(city => (
        <div class="p-4 bg-zinc-900 border border-zinc-800 hover:border-zinc-700 rounded-2xl transition-all flex flex-col justify-between">
          <div>
            <a
              href={`/tankstellen/stadt-${city.slug}/`}
              class="text-base font-bold text-white hover:text-emerald-400 transition-colors block mb-1"
            >
              Tankstellen {city.name} →
            </a>
            <span class="text-xs text-zinc-500 block mb-3">Preise & Tankstellen</span>
          </div>

          <!-- Direct Sublinks for Diesel, Super E10 and Super E5 -->
          <div class="flex items-center gap-2 pt-3 border-t border-zinc-800/80 text-xs">
            <a
              href={`/tankstellen/stadt-${city.slug}/diesel/`}
              class="px-2.5 py-1 bg-zinc-800 hover:bg-emerald-500 hover:text-zinc-950 rounded-lg text-zinc-300 font-semibold transition-colors"
            >
              Diesel
            </a>
            <a
              href={`/tankstellen/stadt-${city.slug}/super-e10/`}
              class="px-2.5 py-1 bg-zinc-800 hover:bg-emerald-500 hover:text-zinc-950 rounded-lg text-zinc-300 font-semibold transition-colors"
            >
              Super E10
            </a>
            <a
              href={`/tankstellen/stadt-${city.slug}/super-e5/`}
              class="px-2.5 py-1 bg-zinc-800 hover:bg-emerald-500 hover:text-zinc-950 rounded-lg text-zinc-300 font-semibold transition-colors"
            >
              Super E5
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Alphabetical A-Z Crawlable City Directory -->
  <section class="max-w-6xl mx-auto px-4 py-12 border-t border-zinc-800">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-black text-white mb-3">Städte-Verzeichnis von A bis Z</h2>
      <p class="text-sm text-zinc-400">Alle Städte und Gemeinden mit aktuellen Spritpreisvergleichen.</p>
    </div>

    <!-- Letter Selector Anchor Nav -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 mb-8 text-xs font-bold">
      {alphabet.map(letter => (
        <a
          href={`#letter-${letter}`}
          class="w-7 h-7 flex items-center justify-center rounded-lg bg-zinc-900 border border-zinc-800 hover:border-emerald-500 hover:text-emerald-400 text-zinc-400 transition-colors"
        >
          {letter}
        </a>
      ))}
    </div>

    <!-- Cities Grouped by Letter -->
    <div class="space-y-8">
      {alphabet.map(letter => {
        const group = citiesByLetter[letter];
        if (!group || group.length === 0) return null;
        return (
          <div id={`letter-${letter}`} class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-5">
            <h3 class="text-xl font-black text-emerald-400 mb-4 pb-2 border-b border-zinc-800">{letter}</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5 text-xs">
              {group.map(c => (
                <a
                  href={`/tankstellen/stadt-${c.slug}/`}
                  class="text-zinc-300 hover:text-emerald-400 truncate transition-colors py-1 block"
                >
                  {c.name}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Client-side Search & Map Scripts -->
  <script is:inline define:vars={{ citySlugMap: Object.fromEntries(cities.map(c => [c.name.toLowerCase(), c.slug])) }}>
    document.addEventListener('DOMContentLoaded', () => {
      // Form submit: navigate to dedicated city URL!
      const form = document.getElementById('search-form');
      const input = document.getElementById('search-input');

      if (form && input) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const query = input.value.trim().toLowerCase();
          if (!query) return;

          // Check if it matches a known city name
          const slug = citySlugMap[query];
          if (slug) {
            window.location.href = `/tankstellen/stadt-${slug}/`;
            return;
          }

          // Otherwise slugify and navigate
          const fallbackSlug = query
            .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
            .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

          window.location.href = `/tankstellen/stadt-${fallbackSlug}/`;
        });
      }

      // Map initialization
      if (typeof L !== 'undefined') {
        const map = L.map('map', { scrollWheelZoom: false }).setView([51.1657, 10.4515], 6); // Germany center
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '© OpenStreetMap'
        }).addTo(map);

        // Fetch sample stations in Berlin, München, Frankfurt, Hamburg
        const centers = [
          { lat: 52.5200, lng: 13.4050, city: 'Berlin', slug: 'berlin' },
          { lat: 48.1351, lng: 11.5820, city: 'München', slug: 'muenchen' },
          { lat: 53.5511, lng: 9.9937, city: 'Hamburg', slug: 'hamburg' },
          { lat: 50.1109, lng: 8.6821, city: 'Frankfurt am Main', slug: 'frankfurt-am-main' },
          { lat: 50.9375, lng: 6.9603, city: 'Köln', slug: 'koeln' }
        ];

        centers.forEach(c => {
          const marker = L.marker([c.lat, c.lng]).addTo(map);
          marker.bindPopup(`
            <div style="font-family: inherit; font-size: 13px;">
              <strong style="color: #10b981; font-size: 14px;">${c.city}</strong><br/>
              <p style="margin: 6px 0 10px; font-size: 11px; color: #a1a1aa;">Aktuelle Benzin- und Dieselpreise</p>
              <a href="/tankstellen/stadt-${c.slug}/" style="display: inline-block; padding: 4px 8px; background: #10b981; color: #09090b; font-weight: bold; border-radius: 6px; text-decoration: none; font-size: 11px;">
                Preise in ${c.city} ansehen →
              </a>
            </div>
          `);
        });

        // Geolocate button
        const geoBtn = document.getElementById('geolocate-btn');
        if (geoBtn && navigator.geolocation) {
          geoBtn.addEventListener('click', () => {
            navigator.geolocation.getCurrentPosition((pos) => {
              const { latitude, longitude } = pos.coords;
              map.setView([latitude, longitude], 12);
            });
          });
        }
      }
    });
  </script>
</Layout>
