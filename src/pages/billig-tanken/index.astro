---
import Layout from '@layouts/Layout.astro';
import cities from '@data/german_cities.json';

const title = "Billig tanken & Günstig tanken in der Nähe — Ratgeber & Vergleich | SpritChecker.de";
const description = "Wie und wann kann man in Deutschland am billigsten tanken? Tipps zum cleveren Sparen, günstige Uhrzeiten und aktuelle Tankstellen-Vergleiche.";
---

<Layout title={title} description={description} canonical="https://spritchecker.de/billig-tanken/">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-gradient-to-br from-zinc-900 to-zinc-950 border border-zinc-800 rounded-3xl p-8 sm:p-12 shadow-2xl mb-12">
      <h1 class="text-3xl sm:text-5xl font-black text-white mb-4">
        Billig tanken: <span class="text-emerald-400">So sparst du bis zu 15 Cent pro Liter</span>
      </h1>
      <p class="text-zinc-300 text-sm sm:text-base leading-relaxed">
        Wer zur richtigen Uhrzeit und an den richtigen Tankstellen tankt, spart bei einem 50-Liter-Tank bis zu 7,50 Euro pro Tankfüllung.
      </p>
    </div>

    <div class="space-y-6 text-zinc-300 text-sm leading-relaxed mb-12">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-2">1. Die beste Uhrzeit zum Tanken</h2>
        <p>
          Die Kraftstoffpreise in Deutschland sind zwischen <strong>18:00 und 22:00 Uhr</strong> am günstigsten. Vermeide es unbedingt, morgens zwischen 06:00 und 09:00 Uhr zu tanken, da die Preise hier regelmäßig ihr Tageshoch erreichen.
        </p>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-2">2. Freie Tankstellen vs. Marken-Tankstellen</h2>
        <p>
          Freie Tankstellen (ohne Markennamen wie Aral oder Shell) und SB-Tankstellen an Supermärkten (Globus, Kaufland, Metro) sind oft 2 bis 5 Cent pro Liter günstiger bei gleicher Kraftstoff-Qualität nach DIN-Norm.
        </p>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white mb-2">3. Autobahn-Tankstellen meiden</h2>
        <p>
          Tanken an der Autobahn ist bis zu 30 bis 40 Cent pro Liter teurer als an Tankstellen wenige Kilometer abseits der Autobahnausfahrt. Fahre bei längeren Fahrten kurz ab und spare sofort bares Geld.
        </p>
      </div>
    </div>

    <!-- City List for Billig Tanken -->
    <h2 class="text-2xl font-bold text-white mb-6">Günstig tanken in deiner Stadt</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {cities.map(c => (
        <a
          href={`/tankstellen/stadt-${c.slug}/`}
          class="p-3.5 bg-zinc-900 border border-zinc-800 hover:border-emerald-500/50 rounded-xl transition-all block group"
        >
          <div class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">{c.name}</div>
          <div class="text-xs text-zinc-500">Günstigste Tankstellen</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
