---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
} = Astro.props;

const siteUrl = 'https://spritchecker.de';
---

<!doctype html>
<html lang="de" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="SpritChecker.de" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Leaflet Map CSS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />

    <!-- Google Consent Mode v2 (Deny by default) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R7JR4JJQCL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-R7JR4JJQCL');
    </script>

    <!-- UniConsent CMP v2.2 (IAB TCF Certified) -->
    <script is:inline type="text/javascript" src="https://cdn.uniconsent.com/v2/stub.min.js"></script>
    <script is:inline async type="text/javascript" src="https://cmp.uniconsent.com/v2/b039ba7539/cmp.js"></script>

    <!-- Google AdSense -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2168172914069272"
      crossorigin="anonymous"
    ></script>

    <!-- Schema.org WebSite -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "SpritChecker.de",
      "url": "https://spritchecker.de",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://spritchecker.de/?suche={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />
  </head>

  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-black">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-emerald-400 flex items-center justify-center text-zinc-950 shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-5 h-5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4m0 0l-3-3m3 3l3-3" />
            </svg>
          </div>
          <div>
            <span class="text-xl font-black tracking-tight text-white">Sprit<span class="text-emerald-400">Checker</span></span>
            <span class="text-[10px] block font-mono text-zinc-400 -mt-1 font-semibold">PREISE DEUTSCHLAND</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-300">
          <a href="/#suche" class="hover:text-emerald-400 transition-colors">PLZ / Ort</a>
          <a href="/#staedte" class="hover:text-emerald-400 transition-colors">Top Städte</a>
          <a href="/#faq" class="hover:text-emerald-400 transition-colors">Häufige Fragen</a>
          <a href="/datenschutz" class="hover:text-emerald-400 transition-colors">Datenschutz</a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-zinc-900 border-t border-zinc-800 py-10 mt-16 text-sm text-zinc-400">
      <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="text-base font-bold text-white mb-1">SpritChecker.de</div>
          <p class="text-xs text-zinc-400 max-w-md">
            Offizielle Kraftstoffpreisdaten der Markttransparenzstelle für Kraftstoffe (MTS-K) des Bundeskartellamtes via Tankerkönig.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-6 text-xs font-semibold">
          <a href="/impressum" class="hover:text-white transition-colors">Impressum</a>
          <a href="/datenschutz" class="hover:text-white transition-colors">Datenschutzerklärung</a>
          <button onclick="if(window.__unicmp){window.__unicmp('openConsentModal');}" class="hover:text-white transition-colors underline cursor-pointer">
            Cookie-Einstellungen
          </button>
        </div>
      </div>

      <!-- Europäisches Kraftstoffpreis-Netzwerk (Internationales SEO Cross-Linking) -->
      <div class="max-w-6xl mx-auto px-4 mt-8 pt-8 border-t border-zinc-800">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-1">
              🇪🇺 Europäisches Spritpreis-Netzwerk
            </div>
            <p class="text-xs font-bold text-white">
              Offizielle, unabhängige Preisvergleichs-Portale für Kraftstoffe in Europa:
            </p>
          </div>
          <span class="text-[11px] text-zinc-500">Offizielle Open-Data-Quellen</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <!-- Deutschland (Diese Seite) -->
          <div class="p-3.5 rounded-xl border border-amber-500/40 bg-amber-950/20 relative">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-black text-white flex items-center gap-1.5">
                <span>🇩🇪</span>
                <span>SpritChecker.de</span>
              </span>
              <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300">
                Deutschland • Aktiv
              </span>
            </div>
            <p class="text-[11px] text-zinc-400 leading-snug">
              Spritpreise in Deutschland mit offiziellen MTS-K Daten des Bundeskartellamtes.
            </p>
          </div>

          <!-- Italien -->
          <a
            href="https://prezzobenza.it/"
            hreflang="it-IT"
            target="_blank"
            rel="noopener"
            class="p-3.5 rounded-xl border border-zinc-800 bg-zinc-900/60 hover:border-emerald-500/50 hover:bg-zinc-800/60 transition-all group"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors flex items-center gap-1.5">
                <span>🇮🇹</span>
                <span>PrezzoBenza.it</span>
              </span>
              <span class="text-[9px] font-semibold text-zinc-500">Italien &rarr;</span>
            </div>
            <p class="text-[11px] text-zinc-400 leading-snug">
              Prezzi benzina, diesel, GPL e metano in tempo reale con Open Data ufficiali del MIMIT.
            </p>
          </a>

          <!-- Frankreich -->
          <a
            href="https://lecarbu.fr/"
            hreflang="fr-FR"
            target="_blank"
            rel="noopener"
            class="p-3.5 rounded-xl border border-zinc-800 bg-zinc-900/60 hover:border-blue-500/50 hover:bg-zinc-800/60 transition-all group"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-bold text-white group-hover:text-blue-400 transition-colors flex items-center gap-1.5">
                <span>🇫🇷</span>
                <span>LeCarbu.fr</span>
              </span>
              <span class="text-[9px] font-semibold text-zinc-500">Frankreich &rarr;</span>
            </div>
            <p class="text-[11px] text-zinc-400 leading-snug">
              Prix des carburants en France (Gazole & SP95) via le Ministère de l'Économie.
            </p>
          </a>

          <!-- Vereinigtes Königreich -->
          <a
            href="https://pumpchecker.co.uk/"
            hreflang="en-GB"
            target="_blank"
            rel="noopener"
            class="p-3.5 rounded-xl border border-zinc-800 bg-zinc-900/60 hover:border-sky-500/50 hover:bg-zinc-800/60 transition-all group"
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-bold text-white group-hover:text-sky-400 transition-colors flex items-center gap-1.5">
                <span>🇬🇧</span>
                <span>PumpChecker.co.uk</span>
              </span>
              <span class="text-[9px] font-semibold text-zinc-500">UK &rarr;</span>
            </div>
            <p class="text-[11px] text-zinc-400 leading-snug">
              UK petrol and diesel prices using official CMA Open Fuel Data scheme.
            </p>
          </a>
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-4 text-center text-xs text-zinc-400 mt-8 pt-6 border-t border-zinc-800">
        © {new Date().getFullYear()} SpritChecker.de — Alle Angaben ohne Gewähr. Kontakt: info@spritchecker.de
      </div>
    </footer>

    <!-- Leaflet JS -->
    <script
      is:inline
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>
  </body>
</html>
